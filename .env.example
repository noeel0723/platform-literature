APP_NAME=Literahaven
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://platform-literature.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=platform_literature
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
GOOGLE_BOOKS_MAX_RESULTS=6
GOOGLE_BOOKS_CONNECT_TIMEOUT=3
GOOGLE_BOOKS_TIMEOUT=8

OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_COVERS_URL=https://covers.openlibrary.org
OPEN_LIBRARY_USER_AGENT="Literahaven/1.0 academic-project"
OPEN_LIBRARY_MAX_RESULTS=6
OPEN_LIBRARY_CACHE_MINUTES=60
OPEN_LIBRARY_CONNECT_TIMEOUT=3
OPEN_LIBRARY_TIMEOUT=10

# Optional: when empty, GOOGLE_BOOKS_API_KEY is reused.
GOOGLE_KNOWLEDGE_GRAPH_API_KEY=
GOOGLE_KNOWLEDGE_GRAPH_BASE_URL=https://kgsearch.googleapis.com/v1/entities:search
GOOGLE_KNOWLEDGE_GRAPH_LANGUAGE=en
GOOGLE_KNOWLEDGE_GRAPH_CANDIDATE_LIMIT=5
GOOGLE_KNOWLEDGE_GRAPH_CACHE_DAYS=30
GOOGLE_KNOWLEDGE_GRAPH_CONNECT_TIMEOUT=3
GOOGLE_KNOWLEDGE_GRAPH_TIMEOUT=8

WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIPEDIA_SUMMARY_URL=https://{language}.wikipedia.org/api/rest_v1/page/summary/{title}
WORK_METADATA_CONTENT_LANGUAGE=en
WORK_METADATA_USER_AGENT="Literahaven/1.0 academic-project"
WORK_METADATA_CACHE_DAYS=30
WORK_METADATA_CONNECT_TIMEOUT=3
WORK_METADATA_TIMEOUT=8

ANILIST_BASE_URL=https://graphql.anilist.co
ANILIST_MAX_RESULTS=6
ANILIST_CONNECT_TIMEOUT=3
ANILIST_TIMEOUT=12

MANGADEX_BASE_URL=https://api.mangadex.org
MANGADEX_COVERS_URL=https://uploads.mangadex.org/covers
MANGADEX_USER_AGENT="Literahaven/1.0 academic-project"
MANGADEX_MAX_RESULTS=6
MANGADEX_CACHE_MINUTES=30
MANGADEX_CONNECT_TIMEOUT=3
MANGADEX_TIMEOUT=12

KITSU_BASE_URL=https://kitsu.io/api/edge
KITSU_USER_AGENT="Literahaven/1.0 academic-project"
KITSU_MAX_RESULTS=6
KITSU_CACHE_MINUTES=30
KITSU_CONNECT_TIMEOUT=3
KITSU_TIMEOUT=12

COMIC_VINE_API_KEY=
COMIC_VINE_BASE_URL=https://comicvine.gamespot.com/api
COMIC_VINE_USER_AGENT="Literahaven/1.0 academic-project"
COMIC_VINE_MAX_RESULTS=6
COMIC_VINE_CACHE_MINUTES=30
COMIC_VINE_CONNECT_TIMEOUT=3
COMIC_VINE_TIMEOUT=12
